# ==============================================================================
# Numpux Runtime Configuration
# ==============================================================================

# Session signing secret. Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-random-secret
SESSION_TTL_SECONDS=604800

# Canonical PostgreSQL connection. No credential defaults exist in application code.
DATABASE_URL=postgresql://postgres:replace-with-db-password@localhost:5432/db_numpux
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Public application origin and optional Google OAuth credentials.
# Callback URL: http://localhost:3000/api/auth/google/callback
APP_URL=http://localhost:3000
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Optional one-time owner bootstrap. Configure all three or leave all three empty.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional manual seed script credential.
SEED_USER_PASSWORD=
